# Database connection (Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# NextAuth (or other session secret)
NEXTAUTH_SECRET=replace-with-your-secret

# Comma-separated emails allowed to use passwordless sign-in in production.
# There is no password-based auth yet, so keep this list to trusted testers only.
PASSWORDLESS_ALLOWED_EMAILS=

# AI provider key (optional, app runs in dev fallback mode without this)
AI_API_KEY=

# Object storage (S3-compatible) - for documents
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Payment gateway (placeholder for South African options like PayFast)
PAYMENT_GATEWAY=payfast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=

# Other deployment-specific vars
RAILWAY_STATIC_URL=

# Feature flags
ENABLE_DEV_AI_FALLBACK=true
