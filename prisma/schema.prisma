generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum RoleName {
  BUSINESS_OWNER
  ADMIN
  MANAGER
  SALES
  FINANCE
  OPERATIONS
  STAFF
  READ_ONLY
}

enum QuoteStatus {
  DRAFT
  AWAITING_INFORMATION
  AWAITING_APPROVAL
  APPROVED
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_REQUIRED
  QUOTE_SENT
  NEGOTIATING
  WON
  LOST
  ON_HOLD
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  NEEDS_INFORMATION
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum BillingCycle {
  WEEKLY
  MONTHLY
  ANNUAL
  ONCE_OFF
}

enum VendorSubscriptionStatus {
  ACTIVE
  TRIAL
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// Core
model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String?  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  customers Customer[]
  subscription Subscription?
}

model User {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  email      String   @unique
  name       String?
  phone      String?
  role       RoleName @default(STAFF)
  isActive   Boolean  @default(true)
  startDate  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Relations (inverse fields)
  customersAssigned Customer[]
  leadsAssigned     Lead[]
  opportunitiesAssigned Opportunity[]
  quotesCreated     Quote[]
  tasksAssigned     Task[]
  approvalsRequested Approval[]
  invoicesCreated   Invoice[]
  leaveRequests     LeaveRequest[]
  timeEntries       TimeEntry[]
  accounts          Account[]
  sessions          Session[]
}

model Subscription {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  planName      String
  priceCents    Int
  currency      String  @default("ZAR")
  status        String
  startedAt     DateTime @default(now())
  currentPeriodEnd DateTime?
}

// External vendor subscriptions the business itself pays for (cloud, AI/LLM
// APIs, hosting, domains, software, etc.) - distinct from the Subscription
// model above, which is the tenant's own BizBrain billing plan.
model VendorSubscription {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  category      String?
  costCents     Int
  currency      String   @default("ZAR")
  billingCycle  BillingCycle @default(MONTHLY)
  status        VendorSubscriptionStatus @default(ACTIVE)
  nextRenewalAt DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  entity     String?
  entityId   String?
  before     Json?
  after      Json?
  source     String?
  createdAt  DateTime @default(now())
}

// CRM
model Customer {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  businessName  String?
  industry      String?
  phone         String?
  email         String?
  address       String?
  billingAddress String?
  tags          String[] @default([])
  notes         String?
  assignedToId  String?
  assignedTo    User?    @relation(fields: [assignedToId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]
  quotes        Quote[]
  invoices      Invoice[]
}

model Contact {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  name       String
  email      String?
  phone      String?
  role       String?
  createdAt  DateTime @default(now())
}

model Lead {
  id            String   @id @default(uuid())
  tenantId      String
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  name          String
  businessName  String?
  email         String?
  phone         String?
  source        String?
  industry      String?
  estimatedValue Int?
  score         Int?      
  status        LeadStatus @default(NEW)
  assignedToId  String?
  assignedTo    User?      @relation(fields: [assignedToId], references: [id])
  nextActionAt  DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Opportunity {
  id           String   @id @default(uuid())
  tenantId     String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  name         String
  description  String?
  amountCents  Int?
  probability  Int?     
  stage        String?
  expectedClose DateTime?
  assignedToId String?
  assignedTo   User?    @relation(fields: [assignedToId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Quotes & Products
model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  unit        String?
  costCents   Int?
  priceCents  Int
  taxRate     Float?   
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quoteItems  QuoteItem[]
  invoiceItems InvoiceItem[]
}

model Quote {
  id           String     @id @default(uuid())
  tenantId     String
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])
  opportunityId String?
  status       QuoteStatus @default(DRAFT)
  totalCents   Int?
  validUntil   DateTime?
  createdById  String?
  createdBy    User?       @relation(fields: [createdById], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        QuoteItem[]
  invoices     Invoice[]
}

model QuoteItem {
  id        String  @id @default(uuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  description String?
  quantity  Int     @default(1)
  unitPriceCents Int
}

model Invoice {
  id            String   @id @default(uuid())
  tenantId      String
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  quoteId       String?
  quote         Quote?   @relation(fields: [quoteId], references: [id])
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  totalCents    Int
  dueDate       DateTime?
  issuedAt      DateTime?
  paidAt        DateTime?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
}

model InvoiceItem {
  id             String   @id @default(uuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  description    String?
  quantity       Int      @default(1)
  unitPriceCents Int
}

model LeaveRequest {
  id        String      @id @default(uuid())
  tenantId  String
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  type      LeaveType   @default(ANNUAL)
  startDate DateTime
  endDate   DateTime
  reason    String?
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
}

model TimeEntry {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime
  hoursWorked Float
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([userId, date])
}

// Tasks, Approvals, Inbox
model Task {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  customerId  String?
  relatedOpportunityId String?
  assignedToId String?
  assignedTo  User?    @relation(fields: [assignedToId], references: [id])
  dueDate     DateTime?
  priority    Int?
  status      TaskStatus @default(NOT_STARTED)
  recurrence  String?
  category    String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Approval {
  id           String   @id @default(uuid())
  tenantId     String
  requestedById String?
  requestedBy  User?    @relation(fields: [requestedById], references: [id])
  action       String
  reason       String?
  riskLevel    String?
  entity       String?
  entityId     String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
}

model InboxItem {
  id          String   @id @default(uuid())
  tenantId    String
  source      String
  sender      String?
  subject     String?
  message     String?
  receivedAt  DateTime @default(now())
  category    String?
  priority    String?
  sentiment   String?
  assignedToId String?
  status      String?
}

model Document {
  id         String   @id @default(uuid())
  tenantId   String
  url        String
  filename   String
  contentType String?
  createdAt  DateTime @default(now())
}

model Website {
  id        String   @id @default(uuid())
  tenantId  String
  domain    String?
  title     String?
  published Boolean  @default(false)
}

model AIEvent {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  type       String
  prompt     String?
  result     Json?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model InventoryItem {
  id            String   @id @default(uuid())
  tenantId      String
  sku           String?
  name          String
  quantity      Int     @default(0)
  reorderLevel  Int?
  location      String?
  costCents     Int?
  priceCents    Int?
  lastUpdated   DateTime @default(now())
}

// Public marketing site newsletter opt-in - not tenant-scoped, these are
// website visitors, not app users.
model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

// NextAuth models (required for PrismaAdapter)
model Account {
  id                 String  @id @default(uuid())
  userId             String
  user               User    @relation(fields: [userId], references: [id])
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  createdAt          DateTime @default(now())
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

